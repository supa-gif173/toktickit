// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Roles & Users
enum Role {
  REQUESTER
  STAFF
  ADMIN
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                   String   @id @default(uuid())
  name                 String
  email                String   @unique
  passwordHash         String
  role                 Role     @default(REQUESTER)
  isActive             Boolean  @default(true)
  mustChangePassword   Boolean  @default(true)
  createdAt            DateTime @default(now())
  tickets              Ticket[] @relation("TicketRequester")
  ownedTickets         Ticket[] @relation("TicketOwner")
  comments             Comment[]
  internalNotes        InternalNote[]
  actionsPerformed     ActionTaken[] @relation("ActionsPerformed")
  actionsAssigned      ActionTaken[] @relation("ActionsAssigned")
  statusChanges        TicketStatusHistory[] @relation("StatusChanges")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model RelatedSystem {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model Ticket {
  id                     String   @id @default(uuid())
  ticketNumber           String   @unique
  summary                String
  description            String
  status                 String   @default("NEW")
  requesterId            String
  ownerId                String?
  categoryId             String
  systemId               String
  requestedPriority      String   @default("LOW")
  itPriority             String   @default("LOW")
  problemAppearsResolved Boolean  @default(false)
  version                Int      @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  requester     User          @relation("TicketRequester", fields: [requesterId], references: [id])
  owner         User?         @relation("TicketOwner", fields: [ownerId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  system        RelatedSystem @relation(fields: [systemId], references: [id])

  attachments   Attachment[]
  comments      Comment[]
  internalNotes InternalNote[]
  actionsTaken  ActionTaken[]
  statusHistory TicketStatusHistory[]
}

model ActionTaken {
  id                String       @id @default(uuid())
  ticketId          String
  ticket            Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  performedById     String
  performedBy       User         @relation("ActionsPerformed", fields: [performedById], references: [id])
  assigneeId        String?
  assignee          User?        @relation("ActionsAssigned", fields: [assigneeId], references: [id])
  actionDateTime    DateTime     @default(now())
  description       String
  result            String?
  status            ActionStatus @default(PENDING)
  followUpRequired  Boolean      @default(false)
  followUpNote      String?
  attachmentNotes   String?
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([ticketId])
  @@index([performedById])
  @@index([assigneeId])
}

model TicketStatusHistory {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  changedById String
  changedBy   User     @relation("StatusChanges", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([ticketId])
  @@index([changedById])
}

model Comment {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model InternalNote {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Attachment {
  id            String    @id @default(uuid())
  ticketId      String?
  fileName      String
  fileSize      Int
  mimeType      String
  storageUrl    String
  uploadedAt    DateTime  @default(now())
  deletedAt     DateTime?
  removalReason String?

  ticket Ticket? @relation(fields: [ticketId], references: [id])
}
