// Define a Category model with:
//   id        Int      @id @default(autoincrement())
//   name      String   @unique
//   createdAt DateTime @default(now())
// Then run:  npx prisma migrate dev --name init
// TODO(Issue 3): add the Category model below.
enum Role {
  REQUESTER
  STAFF
  ADMIN
}

model User {
  id                   String   @id @default(uuid())
  name                 String
  email                String   @unique
  passwordHash         String
  role                 Role     @default(REQUESTER)
  isActive             Boolean  @default(true)
  mustChangePassword   Boolean  @default(true)
  createdAt            DateTime @default(now())
  tickets              Ticket[] @relation("TicketRequester")
  ownedTickets         Ticket[] @relation("TicketOwner")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model RelatedSystem {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model Ticket {
  id           String   @id @default(uuid())
  ticketNumber String   @unique
  summary      String
  description  String
  status       String   @default("New")
  requesterId       String
  ownerId           String?
  categoryId        String
  systemId          String
  requestedPriority String   @default("Low")
  itPriority        String   @default("Low")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  requester User          @relation("TicketRequester", fields: [requesterId], references: [id])
  owner     User?         @relation("TicketOwner", fields: [ownerId], references: [id])
  category  Category      @relation(fields: [categoryId], references: [id])
  system    RelatedSystem @relation(fields: [systemId], references: [id])

  attachments Attachment[]
}

model Attachment {
  id         String    @id @default(uuid())
  ticketId   String?
  fileName   String
  fileSize   Int
  mimeType   String
  storageUrl String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?
  removalReason String?

  ticket Ticket? @relation(fields: [ticketId], references: [id])
}

